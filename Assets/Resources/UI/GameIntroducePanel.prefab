      m_Calls: []
  m_text: "\n\u3010\u6E38\u620F\u51C6\u5907\u3011\n\u5728\u8BAD\u7EC3\u573A\u9636\u6BB5\uFF0C\u6BCF\u4E2A\u4EBA\u4E0A\u9762\u5B58\u5728\u8FD9\u6837\u4E00\u4E2A\u51C6\u5907\u9762\u677F\uFF0C\u73A9\u5BB6\u914D\u7F6E\u5B8C\u67AA\u68B0\u76AE\u80A4\u540E\uFF0C\u70B9\u51FB\u51C6\u5907\u6309\u94AE\u8FDB\u884C\u51C6\u5907\uFF0C\u65C1\u8FB9\u53EF\u4EE5\u67E5\u770B\u623F\u95F4\u51C6\u5907\u4EBA\u6570\n\u3010\u6539\u53D8\u961F\u4F0D\u3011\n\u73A9\u5BB6\u70B9\u51FB\u6539\u53D8\u961F\u53EF\u4EE5\u66F4\u6362\u81EA\u5DF1\u7684\u961F\u4F0D\uFF0C\u961F\u4F0D\u53EA\u6709\u7EA2\u84DD\u4E24\u961F\uFF0C\u65C1\u8FB9\u663E\u793A\u7684\u662F\u961F\u4F0D\u4EBA\u6570\u6BD4\n\u3010\u6E38\u620F\u5F00\u59CB\u6761\u4EF6\u3011\n1.\u623F\u95F4\u5185\u6240\u6709\u73A9\u5BB6\u51C6\u5907\u5B8C\u6210\n2.\u623F\u95F4\u5185\u90E8\u961F\u4F0D\u4EBA\u6570\u6BD4\u662F1\u6BD41,\u4E5F\u5C31\u662F\u4FDD\u8BC1\u516C\u5E73,\u7136\u540E\u5C31\u7B49\u5F85\u623F\u4E3B\u5F00\u542F\u6E38\u620F\n"
  m_enableAdvanceTextProcess: 0
